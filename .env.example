# Copy to .env (which is gitignored) and fill in for local runs.

# Base URL of the target webapp (used by replay verifier)
TARGET_BASE_URL=https://app.example.com

# Optional: path to a Playwright storageState.json captured from a logged-in browser
# session. NEVER commit this file. The kit will only read it.
PLAYWRIGHT_STORAGE_STATE=

# Timeout for replay requests in milliseconds
REPLAY_TIMEOUT_MS=15000
